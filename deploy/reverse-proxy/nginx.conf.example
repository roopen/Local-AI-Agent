# Place this inside the HTTPS server block for news.example.com. The TLS
# certificate and HTTP-to-HTTPS redirect are intentionally left to the host.
location / {
    proxy_pass http://127.0.0.1:8180;
    proxy_http_version 1.1;

    # Overwrite, rather than append to, client-controlled forwarded headers.
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;

    # These also allow SignalR WebSocket upgrades at /newsHub.
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 300s;
}

# Define this once in nginx's top-level http block.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

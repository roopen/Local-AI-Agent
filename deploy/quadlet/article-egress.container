[Unit]
Description=Public-network-only article browser proxy

[Container]
Image=localhost/ainews-article-egress:1
Pull=never
ContainerName=article-egress
Network=article-reader.network:ip=10.203.0.2
Network=article-egress.network
PodmanArgs=--memory=256m
ReadOnly=true
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=always

[Install]
WantedBy=multi-user.target

# Copy to ~/.config/ainews/ainews.env and keep that file out of source control.
PUBLIC_ORIGIN=https://news.example.com

# Use the reverse proxy's exact source address whenever possible. Array indexes
# must be contiguous when more than one value is supplied.
Security__TrustedProxies__0=127.0.0.1
# Security__TrustedProxyNetworks__0=10.88.0.0/16

# Only these client networks can create the very first owner account.
Security__BootstrapAllowedNetworks__0=192.168.1.0/24
# Security__BootstrapAllowedNetworks__1=fd00:1234::/64

SQLITE_DATASOURCE=/data/ainews.db
DATA_PROTECTION_KEYS_PATH=/data/keys

# Optional defaults shown to the owner before the first AI connection is saved.
AI_DEFAULT_ENDPOINT=http://host.containers.internal:1234/v1/
AI_DEFAULT_MODEL=gemma-3-27b-it-qat

# Copy to /etc/ainews/ainews.env with mode 0600 and keep it out of source control.
PUBLIC_ORIGIN=https://news.example.com

# Use the Podman gateway address that the application sees for host-published
# traffic. Find the default rootful gateway with:
# sudo podman network inspect podman --format '{{range .Subnets}}{{.Gateway}}{{end}}'
# Array indexes must be contiguous when more than one value is supplied.
Security__TrustedProxies__0=REPLACE_WITH_PODMAN_GATEWAY
# Security__TrustedProxyNetworks__0=10.88.0.0/16

# When cloudflared connects directly to the loopback listener, use Cloudflare's
# single-address client IP header. Leave this commented for a conventional
# reverse proxy that overwrites X-Forwarded-For.
# Security__ForwardedForHeaderName=CF-Connecting-IP

SQLITE_DATASOURCE=/data/ainews.db
DATA_PROTECTION_KEYS_PATH=/data/keys

# Optional defaults shown to the owner before the first AI connection is saved.
AI_DEFAULT_ENDPOINT=http://host.containers.internal:1234/v1/
AI_DEFAULT_MODEL=gemma-3-27b-it-qat

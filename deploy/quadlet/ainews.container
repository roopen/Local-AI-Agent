[Unit]
Description=AI News private server
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/ainews:latest
Pull=never
ContainerName=ainews
EnvironmentFile=/etc/ainews/ainews.env
PublishPort=127.0.0.1:8180:8080
Volume=ainews.volume:/data:U
ReadOnly=true
Tmpfs=/tmp:rw,size=128m,mode=1777
PodmanArgs=--sysctl=net.ipv4.ip_unprivileged_port_start=0 --add-host=host.containers.internal:host-gateway
HealthCmd=/usr/bin/curl --fail --silent --show-error http://127.0.0.1:8080/alive
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target

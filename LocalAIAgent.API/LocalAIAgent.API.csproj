<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
		<PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
		<PackageReference Include="Microsoft.Bcl.Memory" Version="11.0.0" />
		<PackageReference Include="Microsoft.Bcl.TimeProvider" Version="11.0.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="11.0.0" />
		<PackageReference Include="Fido2" Version="4.0.1" />
		<PackageReference Include="Fido2.AspNet" Version="4.0.1" />
		<PackageReference Include="Fido2.Models" Version="4.0.1" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="11.0.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="11.0.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LocalAIAgent.Tests" />
		<ProjectReference Include="..\LocalAIAgent.Domain\LocalAIAgent.Domain.csproj" />
		<ProjectReference Include="..\LocalAIAgent.Application\LocalAIAgent.Application.csproj" />
		<ProjectReference Include="..\LocalAIAgent.ServiceDefaults\LocalAIAgent.ServiceDefaults.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisMode>Recommended</AnalysisMode>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(PublishProtocol)' != ''">
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<DebugType>embedded</DebugType>
		<IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
	</PropertyGroup>

	<Target Name="GenerateOpenApiSpec" AfterTargets="Build" Condition="'$(SkipClientBuild)' != 'true'">
		<Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Command="dotnet tool run swagger tofile --output openapi/LocalAIAgent.API.json &quot;$(TargetPath)&quot; v1" WorkingDirectory="$(MSBuildProjectDirectory)" EnvironmentVariables="ASPNETCORE_ENVIRONMENT=SwaggerGeneration;ASPNETCORE_URLS=http://localhost:5000" />
	</Target>

	<Target Name="BuildReactApp" BeforeTargets="Build">
		<!-- Linux/Unix CI: Chain clean and install to prevent ENOTEMPTY race conditions -->
		<Exec Command="rm -rf node_modules &amp;&amp; npm ci" Condition="'$(CI)' == 'true' AND '$(OS)' != 'Windows_NT' AND '$(SkipClientBuild)' != 'true'" WorkingDirectory="../LocalAIAgent.WebUI" />
		
		<!-- Windows CI: Clean first if exists -->
		<Exec Command="rmdir /s /q node_modules" Condition="'$(CI)' == 'true' AND '$(OS)' == 'Windows_NT' AND Exists('../LocalAIAgent.WebUI/node_modules') AND '$(SkipClientBuild)' != 'true'" WorkingDirectory="../LocalAIAgent.WebUI" />
		<!-- Windows CI: Run npm ci -->
		<Exec Command="npm ci" Condition="'$(CI)' == 'true' AND '$(OS)' == 'Windows_NT' AND '$(SkipClientBuild)' != 'true'" WorkingDirectory="../LocalAIAgent.WebUI" />

		<!-- Local Development: Standard install -->
		<Exec Command="npm install" Condition="'$(CI)' != 'true' AND '$(SkipClientBuild)' != 'true'" WorkingDirectory="../LocalAIAgent.WebUI" />
		
		<Exec Command="npm run generate:api" Condition="'$(SkipClientBuild)' != 'true'" WorkingDirectory="../LocalAIAgent.WebUI" />
		<Exec Command="npm run build -- --mode production" Condition="'$(SkipClientBuild)' != 'true'" WorkingDirectory="../LocalAIAgent.WebUI" />
		
		<ItemGroup>
			<ReactFiles Include="../LocalAIAgent.WebUI/dist/**" />
		</ItemGroup>
		<Copy SourceFiles="@(ReactFiles)" DestinationFolder="wwwroot/%(RecursiveDir)" />
	</Target>

	<Target Name="CopyWwwrootToPublish" AfterTargets="Publish">
		<ItemGroup>
			<WwwrootFiles Include="wwwroot/**" />
		</ItemGroup>
		<Copy SourceFiles="@(WwwrootFiles)" DestinationFolder="$(PublishDir)wwwroot/%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>
